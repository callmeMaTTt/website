---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="2026 — matt marinic"
  description="what matt is building, learning, and doing in 2026."
>
  <main class="wrap page">
    <!-- swap with: <div class="banner"><img src="/images/2026.jpg" alt=""></div> -->
    <div class="banner banner-terracotta"></div>

    <span class="eyebrow">the year</span>
    <h1 class="page-title">2026</h1>
    <p class="page-lead">
      everything i'm doing, learning and building this year.
    </p>

    <section class="section">
      <div class="section-head">
        <span class="section-label">projects</span>
      </div>
      <div class="card-grid">
        <a href="#" class="card">
          <div class="icon terracotta">i</div>
          <h3>project one</h3>
          <p>a short description of what this project does</p>
        </a>
        <a href="#" class="card">
          <div class="icon olive">ii</div>
          <h3>project two</h3>
          <p>a short description of what this project does</p>
        </a>
        <a href="#" class="card">
          <div class="icon blue">iii</div>
          <h3>project three</h3>
          <p>a short description of what this project does</p>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="section-label">mentions &amp; appearances</span>
      </div>
      <p class="page-lead">appeared in <a href="#">some podcast or article</a></p>
      <p class="page-lead">spoke at <a href="#">some event</a></p>
    </section>

    <Footer />
  </main>
</Base>
