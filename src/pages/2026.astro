---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="2026 — matt marinic"
  description="what matt is building, learning, and doing in 2026."
>
  <main class="wrap page">
    <!-- swap with: <div class="banner"><img src="/images/2026.jpg" alt=""></div> -->
    <div class="banner banner-terracotta"></div>

    <span class="eyebrow">the year</span>
    <h1 class="page-title">2026</h1>
    <p class="page-lead">
      everything i'm doing, learning and building this year.
    </p>

    <section class="section">
      <div class="section-head">
        <span class="section-label">trips</span>
      </div>
      <div class="card-grid">
        <div class="trip-card">
          <div class="img"><img src="/images/grampians.jpg" alt="" /></div>
          <div class="body">
            <h3>grampians</h3>
            <div class="meta">
              <span>victoria</span>
              <span class="date">11/2025</span>
            </div>
          </div>
        </div>
        <div class="trip-card">
          <div class="img"></div>
          <div class="body">
            <h3>next trip</h3>
            <div class="meta">
              <span>country</span>
              <span class="date">mm/yyyy</span>
            </div>
          </div>
        </div>
        <div class="trip-card">
          <div class="img"></div>
          <div class="body">
            <h3>another</h3>
            <div class="meta">
              <span>country</span>
              <span class="date">mm/yyyy</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="section-label">books</span>
      </div>
      <div class="list">
        <div class="list-row">
          <span class="num">i</span>
          <span class="title">a book i loved</span>
          <span class="tag">author name</span>
          <span class="date">2026</span>
        </div>
        <div class="list-row">
          <span class="num">ii</span>
          <span class="title">another good one</span>
          <span class="tag">author name</span>
          <span class="date">2026</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="section-label">videos</span>
      </div>
      <div class="list">
        <div class="list-row">
          <span class="num">i</span>
          <span class="title">a video that stuck with me</span>
          <span class="tag">creator</span>
          <span class="date">2026</span>
        </div>
        <div class="list-row">
          <span class="num">ii</span>
          <span class="title">another favourite</span>
          <span class="tag">creator</span>
          <span class="date">2026</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="section-label">projects</span>
      </div>
      <p class="page-lead" style="font-style: italic; opacity: 0.65;">
        coming soon &mdash; a few things in the works.
      </p>
    </section>

    <Footer />
  </main>
</Base>
