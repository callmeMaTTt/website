---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="matt marinic">
  <main>
    <section class="cover">
      <h1>matt marinic</h1>
      <p class="tagline">
        part-time student, content creator &amp; runner.<br />
        full-time enjoyer of life.
      </p>
      <a href="#more" class="scroll-cue">
        read on
        <span class="cue-arrow"></span>
      </a>
    </section>

    <div class="wrap" id="more" style="padding-top: 40px; padding-bottom: 160px;">
      <!-- swap with: <div class="row-image"><img src="/images/2026.jpg" alt=""></div> -->
      <section class="row">
        <div class="row-image banner-terracotta"></div>
        <div class="row-text">
          <span class="eyebrow">the year</span>
          <h2>2026</h2>
          <p>projects, places, and notes from the year so far.</p>
          <a href="/2026" class="row-link">see the year <span class="arrow">&rarr;</span></a>
        </div>
      </section>

      <!-- swap with: <div class="row-image"><img src="/images/blog.jpg" alt=""></div> -->
      <section class="row reverse">
        <div class="row-image banner-sea"></div>
        <div class="row-text">
          <span class="eyebrow">writing</span>
          <h2>the blog</h2>
          <p>weekly writings, notes &amp; longer thoughts.</p>
          <a href="/blog" class="row-link">read posts <span class="arrow">&rarr;</span></a>
        </div>
      </section>

      <!-- swap with: <div class="row-image"><img src="/images/about.jpg" alt=""></div> -->
      <section class="row">
        <div class="row-image banner-sunset"></div>
        <div class="row-text">
          <span class="eyebrow">elsewhere</span>
          <h2>get in touch</h2>
          <p>email or instagram, whichever's easier.</p>
          <a href="/contact" class="row-link">say hi <span class="arrow">&rarr;</span></a>
        </div>
      </section>

      <Footer />
    </div>
  </main>
</Base>
