---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="contact — matt marinic"
  description="get in touch with matt marinic."
>
  <main class="wrap page">
    <span class="eyebrow">say hello</span>
    <h1 class="page-title">contact</h1>
    <p class="page-lead">
      the best way to reach me is by instagram dm. i try to reply within a few days.
    </p>

    <ul class="contact-list">
      <li>
        <a href="mailto:matthew.marinicc@gmail.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
          email
          <span class="arrow">→</span>
        </a>
      </li>
      <li>
        <a href="https://www.instagram.com/mattmarinic/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          instagram
          <span class="arrow">→</span>
        </a>
      </li>
    </ul>

    <Footer />
  </main>
</Base>
