---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="about — matt marinic" description="about matt marinic.">
  <main class="wrap page">
    <!-- swap with: <div class="banner"><img src="/images/about.jpg" alt=""></div> -->
    <div class="banner banner-sunset"></div>

    <span class="eyebrow">a brief history</span>
    <h1 class="page-title">about <span 

    <div class="prose" style="margin-top: 16px;">
      <p>i'm matt &mdash; a commerce + math student at the university of melbourne, a big time
         runner and sometimes i make reels on instagram.</p>
      <p>
        i also love to travel. if i could travel fulltime, i would. hopefully one day
        i can visit all the countries in the world. that'd be dope. 
      </p>
    </div>

    <section class="section">
      <div class="timeline-head">
        <span>age</span>
        <span>highlight</span>
      </div>
      <div class="list">
        <div class="tl-row">
          <span class="age">0</span>
          <div>
            <h4>born in doha</h4>
            <p>moved back to melb a year later</p>
          </div>
        </div>
        <div class="tl-row">
          <span class="age">9</span>
          <div>
            <h4>started playing soccer</h4>
          </div>
        </div>
        <div class="tl-row">
          <span class="age">15</span>
          <div>
            <h4>realised i wanted to travel the world</h4>
            <p>my new mission</p>
          </div>
        </div>
        <div class="tl-row">
          <span class="age">17</span>
          <div>
            <h4>started taking running seriously</h4>
          <div>
        <div class="tl-row">
          <span class="age">18</span>
          <div>
            <h4>graduated highschool / started uni</h4>
            <p>had freedom (first solo trip)<p>
          </div>
        <div class="tl-row">
          <span class="age">19</span>
          <div>
            <h4>enjoying life</h4>
            <p>life is good<p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Base>
