---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="shell pagehead" style="min-height:52vh;">
    <span class="eyebrow">404</span>
    <h1 class="d2">That page isn&rsquo;t here.</h1>
    <p class="lede">
      The link may be out of date, or the page may have moved in the site
      refresh. The events calendar is the usual destination.
    </p>
    <div class="hero-cta" style="margin-top:26px;">
      <a href="/" class="btn btn-brass">Back home <span class="arw">&rarr;</span></a>
      <a href="/events" class="btn btn-ghost">See what&rsquo;s on</a>
    </div>
  </section>
</Base>
