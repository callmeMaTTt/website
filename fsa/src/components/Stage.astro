---
/**
 * The 3D slot.
 *
 * Pass any real asset as a child and it takes over the stage automatically —
 * a `<canvas>`, a `<model-viewer>`, an `<img>` or a `<video>`. The CSS
 * (`.stage:has(> canvas, …)`) hides the placeholder below the moment one is
 * present, so nothing here needs editing when the club's 3D assets land.
 *
 *   <Stage>
 *     <model-viewer src="/models/fsa.glb" camera-controls auto-rotate />
 *   </Stage>
 *
 * Until then this renders a pure-SVG mark: ~1KB, no JS, no layout shift.
 */
---

<div class="stage">
  <slot />

  <div class="stage-fallback" aria-hidden="true">
    <svg viewBox="0 0 400 400" fill="none">
      <defs>
        <linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--brass)" stop-opacity="0.9" />
          <stop offset="100%" stop-color="var(--brass)" stop-opacity="0.15" />
        </linearGradient>
      </defs>

      <!-- concentric rings, counter-rotating -->
      <g style="transform-origin:200px 200px">
        <circle class="ring ring-a" cx="200" cy="200" r="158"
                stroke="var(--line-2)" stroke-width="1"
                stroke-dasharray="4 10" style="transform-origin:200px 200px" />
        <circle class="ring ring-b" cx="200" cy="200" r="124"
                stroke="url(#sg)" stroke-width="1.4"
                stroke-dasharray="60 22" style="transform-origin:200px 200px" />
        <circle class="ring ring-c" cx="200" cy="200" r="88"
                stroke="var(--line-2)" stroke-width="1"
                stroke-dasharray="2 8" style="transform-origin:200px 200px" />
      </g>

      <circle cx="200" cy="200" r="64" fill="var(--brass-wash)" opacity="0.6" />

      <!-- ascending trace -->
      <path class="trace" pathLength="1"
            d="M148 236 L178 204 L204 224 L252 164"
            stroke="var(--brass)" stroke-width="3.4"
            stroke-linecap="round" stroke-linejoin="round" />
      <circle class="spark" cx="252" cy="164" r="6" fill="var(--brass)"
              style="transform-origin:252px 164px" />

      <!-- quiet tick marks -->
      <g stroke="var(--line-2)" stroke-width="1" opacity="0.75">
        <path d="M200 20 v14" /><path d="M200 366 v14" />
        <path d="M20 200 h14" /><path d="M366 200 h14" />
      </g>
    </svg>
  </div>
</div>
